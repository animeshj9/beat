{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beat",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "beat.animeshj9.com", "custom_domain": true }
  ]
}
