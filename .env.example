# No URL: explicit sample mode. For a physical phone, use your computer's LAN IP.
EXPO_PUBLIC_API_URL=
# Server only. Never prefix credentials with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
INGEST_TOKEN=
PORT=8787
HOST=127.0.0.1
# Optional; defaults to durable local SQLite on Node 24.
DATABASE_URL=
CORS_ORIGIN=http://localhost:8081
# Native Android builds with react-native-maps require a restricted Google Maps key.
GOOGLE_MAPS_API_KEY=
