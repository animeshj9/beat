{
  "name": "beat",
  "version": "0.1.0",
  "description": "A personalised feed of what changed around the places you care about.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "crawl": "node --env-file-if-exists=.env server/crawl.mjs",
    "export": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "build:pwa": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && EXPO_PUBLIC_API_URL= EXPO_OFFLINE=1 expo export --platform web && node scripts/build-pwa.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "build:cloudflare": "npm run check && npm run build:pwa && npm run check:pwa",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc",
    "check:worker": "wrangler deploy --dry-run --config wrangler.jsonc --outdir worker-dist"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.26",
    "expo-location": "^57.0.20",
    "expo-status-bar": "^57.0.1",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "4.135.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
